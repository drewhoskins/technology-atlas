#!/usr/bin/env bash
# atlas-open <entry-id>
# Opens the human-readable atlas page for the given entry id in the default browser.
#
# Examples:
#   bin/atlas-open bus
#   bin/atlas-open bus:horse_omnibus
#   bin/atlas-open component:internal_combustion_engine
#
# macOS uses `open`. On Linux replace with `xdg-open`; on Windows WSL with `wslview`.

set -e

if [ $# -ne 1 ]; then
    echo "Usage: $0 <entry-id>" >&2
    echo "Examples:" >&2
    echo "  $0 bus" >&2
    echo "  $0 bus:horse_omnibus" >&2
    echo "  $0 component:internal_combustion_engine" >&2
    exit 1
fi

ID="$1"
SLUG="${ID//:/__}"
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PAGE="$REPO_ROOT/web/entries/$SLUG.html"

if [ ! -f "$PAGE" ]; then
    echo "Error: no atlas page for id '$ID'" >&2
    echo "Looked for: $PAGE" >&2
    echo "" >&2
    echo "Available entries:" >&2
    for f in "$REPO_ROOT"/web/entries/*.html; do
        name="$(basename "$f" .html)"
        # Reverse the slug: __ -> :
        echo "  ${name//__/:}" >&2
    done
    exit 1
fi

# macOS
if command -v open >/dev/null 2>&1; then
    open "$PAGE"
# Linux fallback
elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$PAGE"
else
    echo "Error: no 'open' or 'xdg-open' command available" >&2
    echo "Open this file manually: $PAGE" >&2
    exit 1
fi
