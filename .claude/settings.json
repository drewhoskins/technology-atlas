{
  "permissions": {
    "allow": [
      "Bash(sqlite3:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(bin/atlas-open:*)",
      "Bash(./bin/atlas-open:*)",
      "Bash(open web/entries/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "rgt hook"
          }
        ]
      }
    ]
  }
}
